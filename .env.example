# Zoho SMTP Settings (For sending emails)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true


# Recipient Email (Where the contact messages will be sent)
RECIPIENT_EMAIL=sampathkumarveesam@gmail.com
